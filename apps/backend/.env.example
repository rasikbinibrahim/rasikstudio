# apps/backend/.env
# Only the settings actually implemented so far (config/logging/health/DB/Redis/rate-limit/auth/
# AI-provider foundation). See DEPLOYMENT_GUIDE.md §4 for the eventual full set.

APP_ENV=development
HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO
LOG_FORMAT=console

# JSON array of allowed origins, e.g. ["http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173"]

# slowapi rate-limit-string syntax, e.g. "100/minute"
RATE_LIMIT_DEFAULT=100/minute

# postgresql+asyncpg://<user>:<password>@<host>:5432/<db> — matches docker-compose.yml's db service
DATABASE_URL=postgresql+asyncpg://rasik:rasik@localhost:5432/rasik_studio
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=3600

REDIS_URL=redis://localhost:6379/0

# ADR 0004's Celery broker/result backend — a separate Redis DB index (not new infrastructure)
# so Celery's own bookkeeping keys can't collide with REDIS_URL's cache/pub-sub keys.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/1

# Required in every non-dev environment — the checked-in defaults are dev-only placeholders.
# SECRET_KEY: any string, signs JWTs. ENCRYPTION_KEY: must be EXACTLY 32 bytes (AES-256-GCM key).
SECRET_KEY=dev-only-secret-key-change-in-production
ENCRYPTION_KEY=dev-only-encryption-key-32bytes!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 — leave blank to disable a provider. Register an OAuth app with each provider first;
# the callback URL to register is {OAUTH_REDIRECT_BASE_URL}/api/v1/auth/oauth/{provider}/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# AI providers (Phase 9). Ollama needs no key — point it at a local/remote Ollama server. Cloud
# providers are opt-in: leave a key blank to disable that provider (is_available() reports False
# and the model router's fallback chain skips it, rather than the app failing to start).
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_RESPONSE_CACHE_TTL_SECONDS=3600
FALLBACK_CHAINS_PATH=config/fallback_chains.yaml
